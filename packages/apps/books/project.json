{
  "name": "books",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/apps/books",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "cd packages/apps/books && npm run build",
        "cwd": "packages/apps/books"
      }
    },
    "test": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "cd packages/apps/books && npm test",
        "cwd": "packages/apps/books"
      }
    }
  },
  "tags": [
    "scope:apps",
    "type:application"
  ]
}
