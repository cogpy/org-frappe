{
  "name": "erpnext_local",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/archive/erpnext_local",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "cd packages/archive/erpnext_local && npm run build",
        "cwd": "packages/archive/erpnext_local"
      }
    },
    "test": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "cd packages/archive/erpnext_local && python -m pytest",
        "cwd": "packages/archive/erpnext_local"
      }
    },
    "lint": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "cd packages/archive/erpnext_local && python -m ruff check .",
        "cwd": "packages/archive/erpnext_local"
      }
    }
  },
  "tags": [
    "scope:archive",
    "type:legacy"
  ]
}
