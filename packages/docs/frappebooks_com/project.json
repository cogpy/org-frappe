{
  "name": "frappebooks_com",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/docs/frappebooks_com",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "cd packages/docs/frappebooks_com && npm run build",
        "cwd": "packages/docs/frappebooks_com"
      }
    },
    "test": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "cd packages/docs/frappebooks_com && python -m pytest",
        "cwd": "packages/docs/frappebooks_com"
      }
    },
    "lint": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "cd packages/docs/frappebooks_com && python -m ruff check .",
        "cwd": "packages/docs/frappebooks_com"
      }
    }
  },
  "tags": [
    "scope:docs",
    "type:documentation"
  ]
}
