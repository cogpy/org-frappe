{
  "name": "erpc",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/infrastructure/erpc",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "cd packages/infrastructure/erpc && npm run build",
        "cwd": "packages/infrastructure/erpc"
      }
    },
    "test": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "cd packages/infrastructure/erpc && python -m pytest",
        "cwd": "packages/infrastructure/erpc"
      }
    },
    "lint": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "cd packages/infrastructure/erpc && python -m ruff check .",
        "cwd": "packages/infrastructure/erpc"
      }
    }
  },
  "tags": [
    "scope:infrastructure",
    "type:infra"
  ]
}
