{
  "name": "translator",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tools/translator",
  "projectType": "application",
  "targets": {
    "test": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "cd packages/tools/translator && python -m pytest",
        "cwd": "packages/tools/translator"
      }
    },
    "lint": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "cd packages/tools/translator && python -m ruff check .",
        "cwd": "packages/tools/translator"
      }
    }
  },
  "tags": [
    "scope:tools",
    "type:tool"
  ]
}
